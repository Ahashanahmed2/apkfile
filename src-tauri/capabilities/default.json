{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "http:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://huggingface.co/**" }
      ]
    },
    "fs:default",
    "fs:allow-write-file",
    "fs:allow-read-file",
    "fs:allow-exists",
    "fs:allow-remove",
    "fs:scope-appdata-recursive",
    "upload:default"
  ]
}