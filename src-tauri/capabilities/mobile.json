{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Mobile capabilities",
  "platforms": ["android", "iOS"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://huggingface.co/**" }
      ]
    },
    "fs:default",
    "fs:allow-write-file",
    "fs:allow-read-file",
    "fs:allow-exists",
    "fs:allow-remove",
    "fs:scope-appdata-recursive",
    "upload:default"
  ]
}